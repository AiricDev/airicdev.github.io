---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import Nav from '@/components/landing/Nav.astro';
import Footer from '@/components/landing/Footer.astro';

const title = 'The Executable Institution Model — Airic Research';
const description =
  'A research framework for understanding how organizational capability can be materialized, represented, delegated to agents, and improved through governed experience.';

const layers = [
  {
    number: '01',
    symbol: 'C',
    title: 'Complete Value-Creation Capability',
    body: 'Everything a company can draw on to create value: people, assets, relationships, reputation, capital, market position, physical capabilities, and its ability to perceive and act in the real world.',
    boundary: 'Outer set · C',
    gap: 'C is the broadest layer in the model. The remaining layers do not attempt to reproduce everything a company is; they progressively identify what can be coordinated, preserved, represented, and executed.',
  },
  {
    number: '02',
    symbol: 'O',
    title: 'Operating Model',
    body: 'The structure through which a company turns its capabilities into coordinated, repeatable outcomes: goals, roles, authority, processes, standards, incentives, resource allocation, information flows, precedents, escalation, and feedback.',
    boundary: 'Scope boundary · C → O',
    gap: 'People, assets, and reality remain outside the operating model; how the organization recognizes, coordinates, allocates, and governs them belongs inside. This is a division of responsibility, not a loss of organizational capability.',
  },
  {
    number: '03',
    symbol: 'M*',
    title: 'Materializable Operating Model',
    body: 'The part of the operating model that can be separated from particular individuals and preserved as a reusable organizational asset: processes, standards, decision principles, authority boundaries, and precedents.',
    boundary: 'Materialization boundary · O → M*',
    gap: 'Personal trust, physical skill, tacit intuition, taste, and situated perception cannot be extracted without loss. A system can still make these dependencies explicit, specify when they are needed, and govern their risks.',
  },
  {
    number: '04',
    symbol: 'Rₜ',
    title: 'Represented Operating Model',
    body: 'The part currently expressed in Airic through document-defined behavior: roles, tasks, processes, standards, precedents, authority boundaries, decision requests, sessions, and links to code, data, tools, and business systems.',
    boundary: 'Representation boundary · M* → Rₜ',
    gap: 'Natural-language ambiguity, conflicting rules, dynamic state, and non-textual knowledge create representation loss. The represented model is therefore versioned, inspectable, and expected to improve through use.',
  },
  {
    number: '05',
    symbol: 'Eₜ',
    title: 'Executable Operating Model',
    body: 'The part a current agent and its runtime can perform reliably: assuming a persistent role, assembling the right context, following process, applying precedents, acting within authority, escalating uncertainty, and leaving a reviewable trace.',
    boundary: 'Execution boundary · Rₜ → Eₜ',
    gap: 'Execution is constrained by model capability, context assembly, retrieval, tool reliability, verification, runtime design, and safety. Progress in models and harnesses expands what can be delegated without changing what the organization has expressed.',
  },
] as const;

const humanResponsibilities = [
  'Perceive changing reality and form new intent',
  'Build trust and hold consequential relationships',
  'Exercise taste, judgment, and moral responsibility',
  'Create new value when no reusable method exists',
  'Own final accountability and change the institution',
] as const;

const agentResponsibilities = [
  'Assume explicit roles and persistent responsibilities',
  'Execute defined processes and quality standards',
  'Apply relevant precedents and decision rules',
  'Use tools and information within granted authority',
  'Surface uncertainty, request decisions, and leave traces',
] as const;

const loop = [
  'Execution',
  'Session Trace',
  'Reflection',
  'Attribution',
  'Behavior Patch',
  'Human Review',
  'Operating Model Update',
] as const;

const hypotheses = [
  {
    id: 'H1',
    title: 'Judgment can become an organizational artifact.',
    body: 'Effective human judgment from real work can be attributed and represented as a stable role, process, standard, precedent, authority boundary, or other operating-model artifact.',
  },
  {
    id: 'H2',
    title: 'Explicit artifacts improve reliable delegation.',
    body: 'Agents using the right operating-model artifacts perform similar work more reliably than agents relying on generic instructions, unstructured memory, or isolated prompts.',
  },
  {
    id: 'H3',
    title: 'Governed reflection improves future execution.',
    body: 'Trace-based reflection can produce scoped, reviewable behavior patches that improve later similar tasks without causing institutional drift or silently expanding authority.',
  },
] as const;
---

<MarketingLayout
  title={title}
  description={description}
  ogImagePath="/research-og.webp"
  ogType="article"
>
  <Nav />
  <main>
    <article>
      <header class="relative overflow-hidden border-b border-border">
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 opacity-30"
          style={{
            backgroundImage: 'radial-gradient(var(--color-border-strong) 1px, transparent 1px)',
            backgroundSize: '24px 24px',
            maskImage: 'linear-gradient(to bottom, black, transparent 82%)',
          }}
        >
        </div>
        <div class="relative mx-auto max-w-6xl px-6 pb-20 pt-16 sm:pb-24 sm:pt-24">
          <div class="flex flex-wrap items-center gap-3 font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground">
            <span class="rounded-full border border-border-strong bg-background px-3 py-1.5 text-foreground">
              Research Note 01
            </span>
            <span>Airic · July 2026</span>
          </div>
          <div class="mt-10 grid gap-10 lg:grid-cols-[1.45fr_0.55fr] lg:items-end">
            <div>
              <p class="font-mono text-sm text-accent">From capability to reliable delegation</p>
              <h1 class="mt-4 max-w-4xl text-5xl font-semibold leading-[1.02] tracking-tight text-foreground sm:text-6xl lg:text-7xl">
                The Executable
                <br />
                Institution Model
              </h1>
              <p class="mt-7 max-w-2xl text-lg leading-relaxed text-muted-foreground sm:text-xl">
                A framework for understanding how an organization’s knowledge, judgment, process,
                and authority can become something that agents reliably execute—and how experience
                can improve the institution itself.
              </p>
            </div>
            <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-lg border border-border bg-border font-mono text-xs lg:grid-cols-1">
              <div class="bg-card p-4">
                <dt class="text-muted-foreground">Status</dt>
                <dd class="mt-1 text-foreground">Research framework</dd>
              </div>
              <div class="bg-card p-4">
                <dt class="text-muted-foreground">Primary mechanism</dt>
                <dd class="mt-1 text-foreground">Reflective Bootstrapping</dd>
              </div>
              <div class="col-span-2 bg-card p-4 lg:col-span-1">
                <dt class="text-muted-foreground">Core question</dt>
                <dd class="mt-1 text-foreground">How much can be reliably delegated?</dd>
              </div>
            </dl>
          </div>
        </div>
      </header>

      <section class="border-b border-border">
        <div class="mx-auto grid max-w-6xl gap-12 px-6 py-20 lg:grid-cols-[0.6fr_1.4fr] lg:py-24">
          <div>
            <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground">Abstract</p>
          </div>
          <div class="max-w-3xl">
            <p class="text-2xl font-medium leading-snug tracking-tight text-foreground sm:text-3xl">
              AI-native companies are often described as organizations where people set direction
              and agents execute work.
            </p>
            <p class="mt-7 text-base leading-relaxed text-muted-foreground sm:text-lg">
              That vision leaves a critical mechanism unspecified. An organization is not merely a
              collection of tasks. It is accumulated judgment, authority, process, precedent, and
              coordination. Before an agent can run part of a company, those capabilities must be
              separable from individuals, represented as durable institutional assets, and bound to
              an execution system that can apply them reliably.
            </p>
            <blockquote class="mt-10 border-l-2 border-accent pl-6 text-xl font-medium leading-relaxed text-foreground sm:text-2xl">
              How does an organization’s capacity for reliable execution become something an agent
              can inherit, perform, and improve?
            </blockquote>
          </div>
        </div>
      </section>

      <section id="five-layer-model" class="border-b border-border bg-secondary/35">
        <div class="mx-auto max-w-6xl px-6 py-20 lg:py-24">
          <div class="max-w-3xl">
            <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground">01 · The model</p>
            <h2 class="mt-4 text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">
              Five layers from reality to execution.
            </h2>
            <p class="mt-5 text-base leading-relaxed text-muted-foreground sm:text-lg">
              Each inner layer is the part of the outer layer that can be captured and operationalized
              more precisely. The gaps are not one problem; they are four different boundaries that
              require different disciplines and evidence.
            </p>
          </div>

          <figure class="mt-12 overflow-hidden rounded-xl border border-border bg-card p-5 sm:p-8">
            <div class="hidden lg:block" aria-label="Five nested layers of the Executable Institution Model">
              <div class="rounded-xl border border-border-strong bg-background p-5">
                <div class="flex items-center justify-between gap-4">
                  <span class="font-mono text-sm font-semibold">C</span>
                  <span class="font-mono text-xs text-muted-foreground">Complete Value-Creation Capability</span>
                </div>
                <div class="mt-5 rounded-xl border border-border-strong bg-secondary/60 p-5">
                  <div class="flex items-center justify-between gap-4">
                    <span class="font-mono text-sm font-semibold">O</span>
                    <span class="font-mono text-xs text-muted-foreground">Operating Model</span>
                  </div>
                  <div class="mt-5 rounded-xl border border-border-strong bg-background p-5">
                    <div class="flex items-center justify-between gap-4">
                      <span class="font-mono text-sm font-semibold">M*</span>
                      <span class="font-mono text-xs text-muted-foreground">Materializable Operating Model</span>
                    </div>
                    <div class="mt-5 rounded-xl border border-accent/50 bg-secondary/60 p-5">
                      <div class="flex items-center justify-between gap-4">
                        <span class="font-mono text-sm font-semibold">Rₜ</span>
                        <span class="font-mono text-xs text-muted-foreground">Represented Operating Model</span>
                      </div>
                      <div class="mt-5 rounded-xl border border-foreground bg-foreground p-6 text-background">
                        <div class="flex items-center justify-between gap-4">
                          <span class="font-mono text-sm font-semibold">Eₜ</span>
                          <span class="font-mono text-xs text-background/70">Executable Operating Model</span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <ol class="grid gap-2 lg:hidden" aria-label="Five layers of the Executable Institution Model">
              {
                layers.map((layer, index) => (
                  <li class:list={[
                    'flex items-center gap-4 rounded-lg border p-4',
                    index === layers.length - 1
                      ? 'border-foreground bg-foreground text-background'
                      : 'border-border-strong bg-background text-foreground',
                  ]}>
                    <span class="w-8 shrink-0 font-mono text-sm font-semibold">{layer.symbol}</span>
                    <span class:list={[
                      'text-sm',
                      index === layers.length - 1 ? 'text-background/75' : 'text-muted-foreground',
                    ]}>
                      {layer.title}
                    </span>
                  </li>
                ))
              }
            </ol>

            <figcaption class="mt-6 flex flex-col gap-2 border-t border-border pt-5 sm:flex-row sm:items-center sm:justify-between">
              <code class="font-mono text-base text-foreground">Eₜ ⊆ Rₜ ⊆ M* ⊆ O ⊆ C</code>
              <span class="font-mono text-[11px] text-muted-foreground">inner layers are subsets of outer layers</span>
            </figcaption>
          </figure>
        </div>
      </section>

      <section class="border-b border-border">
        <div class="mx-auto max-w-6xl px-6 py-20 lg:py-24">
          <div class="max-w-3xl">
            <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground">02 · The layers</p>
            <h2 class="mt-4 text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">
              Each boundary names a different problem.
            </h2>
          </div>

          <div class="mt-12 divide-y divide-border border-y border-border">
            {
              layers.map((layer) => (
                <section class="grid gap-5 py-9 sm:grid-cols-[4rem_1fr] lg:grid-cols-[4rem_0.85fr_1.15fr] lg:gap-10 lg:py-12">
                  <div class="font-mono text-xs text-muted-foreground">
                    <span>{layer.number}</span>
                    <span class="ml-2 text-accent">{layer.symbol}</span>
                  </div>
                  <div>
                    <h3 class="text-xl font-semibold tracking-tight text-foreground sm:text-2xl">{layer.title}</h3>
                    <p class="mt-4 text-base leading-relaxed text-muted-foreground">{layer.body}</p>
                  </div>
                  <div class="sm:col-start-2 lg:col-start-auto">
                    <div class="rounded-lg border border-border bg-secondary/35 p-5">
                      <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-accent">{layer.boundary}</p>
                      <p class="mt-3 text-sm leading-relaxed text-foreground/80">{layer.gap}</p>
                    </div>
                  </div>
                </section>
              ))
            }
          </div>
        </div>
      </section>

      <section class="border-b border-border bg-foreground text-background">
        <div class="mx-auto max-w-6xl px-6 py-20 lg:py-24">
          <div class="max-w-3xl">
            <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-background/50">03 · Division of responsibility</p>
            <h2 class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl">
              Reliable delegation, not total replacement.
            </h2>
            <p class="mt-5 text-base leading-relaxed text-background/65 sm:text-lg">
              The goal is to maximize the part of the organization that can be delegated with
              confidence—not to pretend every source of value can or should become software.
            </p>
          </div>

          <div class="mt-12 grid gap-px overflow-hidden rounded-xl border border-background/15 bg-background/15 lg:grid-cols-2">
            <div class="bg-foreground p-6 sm:p-8">
              <p class="font-mono text-xs uppercase tracking-[0.16em] text-background/45">Human responsibility</p>
              <h3 class="mt-3 text-2xl font-semibold">Stay close to reality.</h3>
              <ul class="mt-7 space-y-4">
                {
                  humanResponsibilities.map((item) => (
                    <li class="flex gap-3 text-sm leading-relaxed text-background/70">
                      <span class="mt-0.5 font-mono text-accent">H</span>
                      <span>{item}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div class="bg-foreground p-6 sm:p-8">
              <p class="font-mono text-xs uppercase tracking-[0.16em] text-background/45">Agent responsibility</p>
              <h3 class="mt-3 text-2xl font-semibold">Run what the institution knows.</h3>
              <ul class="mt-7 space-y-4">
                {
                  agentResponsibilities.map((item) => (
                    <li class="flex gap-3 text-sm leading-relaxed text-background/70">
                      <span class="mt-0.5 font-mono text-accent">A</span>
                      <span>{item}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
          <p class="mt-8 max-w-3xl text-lg leading-relaxed text-background/80">
            Humans remain responsible for direction, exceptions, relationships, creation, and final
            accountability. Agents inherit institutionalized responsibilities and return uncertainty
            to people through explicit decision requests.
          </p>
        </div>
      </section>

      <section class="border-b border-border">
        <div class="mx-auto max-w-6xl px-6 py-20 lg:py-24">
          <div class="max-w-3xl">
            <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground">04 · Two paths of progress</p>
            <h2 class="mt-4 text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">
              Express more. Execute more.
            </h2>
            <p class="mt-5 text-base leading-relaxed text-muted-foreground sm:text-lg">
              Airic separates progress in organizational learning from progress in model execution.
              This prevents a better model from being mistaken for a better institution.
            </p>
          </div>

          <div class="mt-12 grid gap-5 lg:grid-cols-2">
            <div class="rounded-xl border border-border bg-card p-6 sm:p-8">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="font-mono text-xs uppercase tracking-[0.16em] text-accent">Reflective Bootstrapping</p>
                  <h3 class="mt-3 text-2xl font-semibold tracking-tight">Rₜ → M*</h3>
                </div>
                <span class="font-mono text-3xl text-border-strong">01</span>
              </div>
              <p class="mt-7 text-base leading-relaxed text-muted-foreground">
                Make more organizational capability explicit. Real work reveals missing rules,
                standards, precedents, authority boundaries, and process knowledge. Reflection
                attributes the gap and proposes a governed change to the represented model.
              </p>
            </div>
            <div class="rounded-xl border border-border bg-card p-6 sm:p-8">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="font-mono text-xs uppercase tracking-[0.16em] text-accent">Model + Harness Progress</p>
                  <h3 class="mt-3 text-2xl font-semibold tracking-tight">Eₜ → Rₜ</h3>
                </div>
                <span class="font-mono text-3xl text-border-strong">02</span>
              </div>
              <p class="mt-7 text-base leading-relaxed text-muted-foreground">
                Reliably execute more of what is already expressed. Better models, context assembly,
                tools, verification, session runtimes, and safety mechanisms expand executable scope
                without silently changing the institution’s rules.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section id="learning-loop" class="border-b border-border bg-secondary/35">
        <div class="mx-auto max-w-6xl px-6 py-20 lg:py-24">
          <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
            <div>
              <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground">05 · Capability accumulation</p>
              <h2 class="mt-4 text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">
                Experience must change what happens next.
              </h2>
              <p class="mt-5 text-base leading-relaxed text-muted-foreground">
                An institution does not learn merely because it stores more conversations. Learning
                occurs when evidence from execution becomes a scoped, reviewable change to future
                behavior.
              </p>
              <blockquote class="mt-8 border-l-2 border-accent pl-5 text-lg font-medium leading-relaxed text-foreground">
                Human review is where judgment is deposited—not a bottleneck to eliminate.
              </blockquote>
            </div>

            <div class="rounded-xl border border-border bg-card p-5 sm:p-7">
              <ol class="grid gap-2">
                {
                  loop.map((step, index) => (
                    <li class="flex items-center gap-4 rounded-lg border border-border bg-background p-4">
                      <span class="w-6 shrink-0 text-right font-mono text-xs text-muted-foreground">
                        {String(index + 1).padStart(2, '0')}
                      </span>
                      <span class="font-mono text-accent">→</span>
                      <span class="text-sm font-medium text-foreground">{step}</span>
                      {step === 'Human Review' && (
                        <span class="ml-auto rounded-full border border-border-strong px-2 py-1 font-mono text-[10px] uppercase tracking-wider text-muted-foreground">
                          authority gate
                        </span>
                      )}
                    </li>
                  ))
                }
              </ol>
              <p class="mt-5 border-t border-border pt-5 font-mono text-xs leading-relaxed text-muted-foreground">
                Experience → Attribution → Governed Behavior Patch → Better Future Delegation
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="border-b border-border">
        <div class="mx-auto max-w-6xl px-6 py-20 lg:py-24">
          <div class="max-w-3xl">
            <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground">06 · Research agenda</p>
            <h2 class="mt-4 text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">
              A framework that can be proven wrong.
            </h2>
            <p class="mt-5 text-base leading-relaxed text-muted-foreground sm:text-lg">
              The Executable Institution Model is a research program, not a claim that the full
              system already works. It decomposes a large vision into three smaller hypotheses that
              can be tested through real delegated work.
            </p>
          </div>

          <div class="mt-12 grid gap-5 lg:grid-cols-3">
            {
              hypotheses.map((hypothesis) => (
                <article class="relative rounded-xl border border-border bg-card p-6 text-foreground sm:p-7">
                  <div class="flex items-center justify-between gap-3">
                    <span class="font-mono text-sm font-semibold text-foreground">
                      {hypothesis.id}
                    </span>
                  </div>
                  <h3 class="mt-7 text-xl font-semibold leading-snug tracking-tight">{hypothesis.title}</h3>
                  <p class="mt-4 text-sm leading-relaxed text-muted-foreground">
                    {hypothesis.body}
                  </p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="border-b border-border">
        <div class="mx-auto grid max-w-6xl gap-10 px-6 py-20 lg:grid-cols-[0.6fr_1.4fr] lg:py-28">
          <div>
            <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground">Conclusion</p>
          </div>
          <div class="max-w-3xl">
            <h2 class="text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">
              Toward the executable institution.
            </h2>
            <p class="mt-6 text-lg leading-relaxed text-muted-foreground">
              Most AI systems focus on making individual agents more capable. Airic focuses on a
              different problem: how an organization can turn accumulated judgment and operating
              experience into an explicit, versioned, executable, and continuously improving
              institutional asset.
            </p>
            <p class="mt-5 text-lg leading-relaxed text-muted-foreground">
              The goal is not a company without people. It is an institution where understood and
              governed responsibilities can be delegated reliably—leaving human attention for
              reality, relationships, creation, and final responsibility.
            </p>
            <div class="mt-9 flex flex-wrap gap-3">
              <a
                href="https://github.com/airicdev"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center rounded-md bg-foreground px-5 py-3 text-sm font-medium text-background transition-opacity hover:opacity-90"
              >
                Follow Airic on GitHub ↗
              </a>
            </div>
          </div>
        </div>
      </section>
    </article>
  </main>
  <Footer />
</MarketingLayout>
